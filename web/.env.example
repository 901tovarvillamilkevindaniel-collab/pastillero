# Copia este archivo como .env y llena los valores. El .env real nunca va a git.

# --- Supabase (proyecto ylhflnfqmeywktasmdda) ---
SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
# Clave pública. Con RLS sin políticas no puede leer ni escribir ninguna tabla.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Project Settings → API Keys → secret key. La usan las funciones de Vercel.
SUPABASE_SECRET_KEY=sb_secret_...
# Contraseña de Postgres (conexión directa, migraciones o psql).
SUPABASE_DB_PASSWORD=

# --- Clave del ESP32. El portal es de acceso libre. ---
# Genérala con: python -c "import secrets; print(secrets.token_urlsafe(32))"
DEVICE_KEY=

# --- Hora ---
TIMEZONE=America/Bogota

# --- Solo en tu PC (NO poner en Vercel) ---
# Token personal de Supabase (sbp_...): da acceso a TODA tu cuenta. Lo usan la CLI y las migraciones.
SUPABASE_ACCESS_TOKEN=
